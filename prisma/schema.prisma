datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// USUARIOS Y ROLES (Control de Acceso)
// ----------------------------------------------------
enum UserRole {
  ADMIN       // Acceso total a todas las líneas
  OPERATOR    // Registro de campo (alimento, bajas, pesaje, recolección)
  SWINE_ONLY  // Rol exclusivo para el negocio de cerdos
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// BODEGA E INVENTARIO INDEPENDIENTE
// ----------------------------------------------------
enum BusinessUnit {
  POLLOS
  PONEDORAS
  PECES
  CERDOS
}

enum SupplyType {
  CONCENTRADO
  MEDICAMENTO
  INSUMO_GENERAL
  EQUIPO
}

model FarmSupply {
  id             String       @id @default(uuid())
  business       BusinessUnit // Separa qué alimento es de qué línea
  name           String       // Ej: "Engorde Iniciación", "Ponedoras Fase 1", "Mojarra 32%", "Cerdos Ceba"
  type           SupplyType   @default(CONCENTRADO)
  unit           String       @default("KG") // KG, BULTO, LITRO
  currentStock   Decimal      @default(0) @db.Decimal(10, 2)
  avgCostPerUnit Decimal      @default(0) @db.Decimal(10, 2)
  minAlertStock  Decimal      @default(50) @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  movements      FarmSupplyMovement[]
}

model FarmSupplyMovement {
  id        String     @id @default(uuid())
  supplyId  String
  supply    FarmSupply @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  type      String     // "ENTRADA_COMPRA", "SALIDA_CONSUMO", "AJUSTE"
  quantity  Decimal    @db.Decimal(10, 2)
  unitCost  Decimal    @default(0) @db.Decimal(10, 2)
  totalCost Decimal    @default(0) @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime   @default(now())
}

// ====================================================
// 1. MÓDULO AVICULTURA (POLLOS DE ENGORDE)
// ====================================================
model PoultryBatch {
  id              String            @id @default(uuid())
  batchCode       String            @unique
  startDate       DateTime          @default(now())
  endDate         DateTime?
  initialQuantity Int
  currentQuantity Int
  chickCostTotal  Decimal           @default(0) @db.Decimal(10, 2)
  status          String            @default("EN_ENGORDE") // "EN_ENGORDE" o "LIQUIDADO"
  
  feedersCount    Int               @default(0) // Comederos asignados
  drinkersCount   Int               @default(0) // Bebederos asignados

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  dailyLogs       PoultryDailyLog[]
  sales           PoultrySale[]
  samplings       PoultrySampling[]
  treatments      PoultryTreatment[]
}

model PoultryDailyLog {
  id             String       @id @default(uuid())
  batchId        String
  batch          PoultryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  mortalityCount Int          @default(0)
  feedBrand      String       @default("ITALCOL_DORADA")
  feedKgServed   Decimal      @default(0) @db.Decimal(10, 2)
  feedCost       Decimal      @default(0) @db.Decimal(10, 2)
  notes          String?
}

model PoultrySale {
  id            String       @id @default(uuid())
  batchId       String
  batch         PoultryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date          DateTime     @default(now())
  birdsSold     Int
  saleType      String       @default("EN_PIE")
  totalWeight   Decimal      @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal      @default(0) @db.Decimal(10, 2)
  paymentStatus String       @default("PAGADO")
  customer      String?
  notes         String?
  createdAt     DateTime     @default(now())
}

model PoultrySampling {
  id             String       @id @default(uuid())
  batchId        String
  batch          PoultryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  sampleBirds    Int          @default(10)
  avgWeightGrams Decimal      @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime     @default(now())
}

model PoultryTreatment {
  id             String       @id @default(uuid())
  batchId        String
  batch          PoultryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  productName    String
  treatmentType  String       @default("VITAMINA") // "VACUNA", "VITAMINA", "ANTIBIOTICO", "DESPARASITANTE"
  dose           String?
  withdrawalDays Int          @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
}

// ====================================================
// 1.1 MÓDULO GALLINAS PONEDORAS (POSTURA Y HUEVOS)
// ====================================================
model LayerBatch {
  id          String   @id @default(uuid())
  batchCode   String   @unique
  startDate   DateTime
  initialHens Int
  currentHens Int
  costTotal   Decimal  @default(0) @db.Decimal(10, 2)
  status      String   @default("EN_POSTURA")
  createdAt   DateTime @default(now())

  eggLogs     LayerDailyLog[]
  sales       LayerEggSale[]
}

model LayerDailyLog {
  id             String     @id @default(uuid())
  batchId        String
  batch          LayerBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date           DateTime   @default(now())
  mortalityCount Int        @default(0)
  feedKgServed   Decimal    @default(0) @db.Decimal(10, 2)
  eggsCollected  Int        @default(0)
  eggsBroken     Int        @default(0)
  notes          String?
}

model LayerEggSale {
  id           String     @id @default(uuid())
  batchId      String
  batch        LayerBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date         DateTime   @default(now())
  panalesSold  Decimal    @default(0) @db.Decimal(10, 2)
  unitsSold    Int        @default(0)
  totalAmount  Decimal    @db.Decimal(10, 2)
  customerName String?
  isPaid       Boolean    @default(true)
}

// ====================================================
// 2. MÓDULO PISCICULTURA (ESTANQUES Y PECES)
// ====================================================
model FishBatch {
  id               String         @id @default(uuid())
  pondCode         String         @unique
  species          String         @default("TILAPIA_ROJA")
  startDate        DateTime       @default(now())
  endDate          DateTime?
  initialQuantity  Int
  currentQuantity  Int
  seedCostTotal    Decimal        @default(0) @db.Decimal(10, 2)
  currentAvgWeight Decimal        @default(0) @db.Decimal(10, 2)
  status           String         @default("ENGORDE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  dailyLogs        FishDailyLog[]
  samplings        FishSampling[]
  harvests         FishHarvest[]
}

model FishDailyLog {
  id                 String    @id @default(uuid())
  batchId            String
  batch              FishBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date               DateTime  @default(now())
  mortalityCount     Int       @default(0)
  feedBrand          String?
  proteinPercentage  Int?
  feedKgServed       Decimal   @default(0) @db.Decimal(10, 2)
  feedCost           Decimal   @default(0) @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime  @default(now())
}

model FishSampling {
  id               String    @id @default(uuid())
  batchId          String
  batch            FishBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date             DateTime  @default(now())
  sampleCount      Int
  avgWeightGrams   Decimal   @db.Decimal(10, 2)
  estimatedBiomass Decimal   @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime  @default(now())
}

model FishHarvest {
  id            String     @id @default(uuid())
  batchId       String
  batch         FishBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date          DateTime   @default(now())
  fishCount     Int        @default(0)
  totalKg       Decimal    @db.Decimal(10, 2)
  pricePerKg    Decimal    @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal    @default(0) @db.Decimal(10, 2)
  paymentStatus String     @default("PAGADO")
  customer      String?
  notes         String?
  createdAt     DateTime   @default(now())

  sales         FishSale[]
}

model FishSale {
  id            String       @id @default(uuid())
  harvestId     String?
  harvest       FishHarvest? @relation(fields: [harvestId], references: [id], onDelete: SetNull)
  date          DateTime     @default(now())
  saleFormat    String       @default("DETAL")
  kgSold        Decimal      @db.Decimal(10, 2)
  fishCount     Int?         @default(0)
  pricePerKg    Decimal      @db.Decimal(10, 2)
  totalPrice    Decimal      @db.Decimal(10, 2)
  paymentStatus String       @default("PAGADO")
  customer      String?
  notes         String?
  createdAt     DateTime     @default(now())
}

// ====================================================
// 3. MÓDULO PORCICULTURA (CRÍA, DESTETE Y CEBA)
// ====================================================

enum SwineStage {
  CRIA_REPRODUCCION // Cerdas de cría / parideras
  DESTETE_PRECEBO   // Lechones recién destetados en transición
  CEBA_ENGORDE      // Cerdos en engorde final
}

model SwineSow {
  id              String       @id @default(uuid())
  code            String       @unique // Ej: CERDA-01, "La Manchada"
  breed           String?      // Ej: Landrace, Pietrain, F1
  status          String       @default("VACIA") // "VACIA", "GESTANTE", "LACTANDO", "DESCARTADA"
  entryDate       DateTime     @default(now())
  notes           String?
  createdAt       DateTime     @default(now())

  farrowings      SwineFarrowing[]
}

model SwineFarrowing {
  id              String       @id @default(uuid())
  sowId           String
  sow             SwineSow     @relation(fields: [sowId], references: [id], onDelete: Cascade)
  matingDate      DateTime?    // Fecha de monta / inseminación
  expectedDate    DateTime?    // Fecha calculada (+114 días)
  farrowingDate   DateTime?    // Fecha real de parto
  bornAlive       Int          @default(0) // Nacidos vivos
  bornDead        Int          @default(0) // Nacidos muertos / momias
  weanedCount     Int?         @default(0) // Lechones logrados al destete
  weaningDate     DateTime?    // Fecha del destete
  weaningAvgWeight Decimal?    @db.Decimal(10, 2) // Peso promedio al destetar (Kg)
  notes           String?
  createdAt       DateTime     @default(now())
}

model SwineBatch {
  id                String            @id @default(uuid())
  batchCode         String            @unique // Ej: PRECEBO-LOTE-1 o CEBA-CORRAL-2
  stage             SwineStage        @default(CEBA_ENGORDE)
  startDate         DateTime          @default(now())
  endDate           DateTime?
  initialQuantity   Int
  currentQuantity   Int
  initialAvgWeight  Decimal           @default(10) @db.Decimal(10, 2)
  currentAvgWeight  Decimal           @default(10) @db.Decimal(10, 2)
  purchaseCostTotal Decimal           @default(0) @db.Decimal(10, 2) // $0 si son nacidos en granja
  origin            String            @default("GRANJA") // "GRANJA" o "COMPRA_EXTERNA"
  status            String            @default("ACTIVO") // "ACTIVO" o "LIQUIDADO"

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  dailyLogs         SwineDailyLog[]
  samplings         SwineSampling[]
  sales             SwineSale[]
}

model SwineDailyLog {
  id             String     @id @default(uuid())
  batchId        String
  batch          SwineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date           DateTime   @default(now())
  mortalityCount Int        @default(0)
  feedPhase      String?    // "PREINICIACION", "INICIACION", "LEVANTE", "ENGORDE"
  feedKgServed   Decimal    @default(0) @db.Decimal(10, 2)
  feedCost       Decimal    @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime   @default(now())
}

model SwineSampling {
  id          String     @id @default(uuid())
  batchId     String
  batch       SwineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date        DateTime   @default(now())
  sampleCount Int        @default(5)
  avgWeightKg Decimal    @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime   @default(now())
}

model SwineSale {
  id            String     @id @default(uuid())
  batchId       String
  batch         SwineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date          DateTime   @default(now())
  pigsSold      Int        @default(1)
  totalWeightKg Decimal    @db.Decimal(10, 2)
  pricePerKg    Decimal    @db.Decimal(10, 2)
  totalPrice    Decimal    @db.Decimal(10, 2)
  saleType      String     @default("EN_PIE") // "LECHON_DESTETADO", "EN_PIE", "CANAL", "DESTINO_CHORIZOS"
  paymentStatus String     @default("PAGADO") // "PAGADO" o "FIADO"
  customer      String?
  notes         String?
  createdAt     DateTime   @default(now())
}